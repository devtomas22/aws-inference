[Unit]
Description=Publish aws-inference tunnel URL to SSM Parameter Store
After=aws-inference-tunnel.service
Wants=aws-inference-tunnel.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/aws-inference/repo/ec2/publish-tunnel-url.sh
EnvironmentFile=/opt/aws-inference/env-vars

[Install]
WantedBy=multi-user.target
